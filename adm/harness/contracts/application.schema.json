{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adm/harness/contracts/application.schema.json",
  "title": "Canonical ADM Application Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_id", "application_name", "product_group", "product_name", "application_type", "confidence", "validation_status", "source_records", "evidence_refs"],
  "properties": {
    "application_id": {"type": "string", "minLength": 1},
    "application_name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "product_group": {"enum": ["Payments_In_Vehicle", "Dispatch_Network_ERP", "Booking_Online_Payments", "Corporate_Gov", "Data_Analytics", "Architecture", "IT_Operations", "MTI", "Corporate_IT", "Information_Security", "Phoenix", "Other", "Unknown"]},
    "product_name": {"type": ["string", "null"]},
    "application_type": {"enum": ["application", "business_service", "technical_service", "other", "unknown"]},
    "business_context": {"type": ["string", "null"]},
    "consumers": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "array", "items": {"type": "string"}},
    "lifecycle_status": {"type": ["string", "null"]},
    "application_owner": {"type": ["string", "null"]},
    "business_owner": {"type": ["string", "null"]},
    "technical_owner": {"type": ["string", "null"]},
    "technical_support_team": {"type": ["string", "null"]},
    "lifecycle_owner": {"type": ["string", "null"]},
    "criticality": {"type": ["string", "null"]},
    "hosting_model": {"type": ["string", "null"]},
    "product_or_vendor": {"type": ["string", "null"]},
    "customer_or_tenant": {"type": ["string", "null"]},
    "program_or_jurisdiction": {"type": ["string", "null"]},
    "payment_model": {"type": ["string", "null"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_record_id", "original_name"], "properties": {"source_id": {"type": "string"}, "source_record_id": {"type": "string"}, "original_name": {"type": ["string", "null"]}}}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["confirmed", "probable", "candidate", "unknown", "rejected"]},
    "validation_status": {"enum": ["not_reviewed", "needs_validation", "owner_validated", "approved", "rejected"]},
    "last_observed": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
