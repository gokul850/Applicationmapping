{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adm/harness/contracts/ci.schema.json",
  "title": "ADM Technical CI and Deployment Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["ci_id", "ci_name", "ci_type", "environment", "source_records", "application_ids", "evidence_refs", "confidence", "validation_status"],
  "properties": {
    "ci_id": {"type": "string", "minLength": 1},
    "ci_name": {"type": "string", "minLength": 1},
    "ci_type": {"enum": ["physical_server", "virtual_machine", "cluster", "container_platform", "application_runtime", "database", "data_store", "api", "api_gateway", "queue", "message_broker", "network", "load_balancer", "managed_device", "platform_service", "other", "unknown"]},
    "native_resource_id": {"type": ["string", "null"]},
    "subscription": {"type": ["string", "null"]},
    "resource_group": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "hostname_or_endpoint": {"type": ["string", "null"]},
    "environment": {"type": "string", "minLength": 1},
    "deployment_id": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "customer_or_tenant": {"type": ["string", "null"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_record_id"], "properties": {"source_id": {"type": "string"}, "source_record_id": {"type": "string"}, "native_id": {"type": ["string", "null"]}}}},
    "application_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["confirmed", "probable", "candidate", "unknown", "rejected"]},
    "validation_status": {"enum": ["not_reviewed", "needs_validation", "owner_validated", "approved", "rejected"]},
    "last_observed": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
