{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adm/harness/contracts/relationship.schema.json",
  "title": "ADM Dependency Relationship Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationship_id", "source_id", "target_id", "relationship_type", "relationship_category", "environment", "evidence_refs", "confidence", "validation_status"],
  "properties": {
    "relationship_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "relationship_type": {"enum": ["calls", "reads_from", "writes_to", "sends_messages_to", "authenticates_through", "hosted_by", "runs_on", "routes_through", "monitored_by", "supports", "other", "unknown"]},
    "relationship_category": {"enum": ["business_support", "runtime_application_dependency", "application_to_ci", "infrastructure", "ownership_support"]},
    "environment": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"enum": ["confirmed", "probable", "candidate", "unknown", "rejected"]},
    "validation_status": {"enum": ["not_reviewed", "needs_validation", "owner_validated", "approved", "rejected"]},
    "last_observed": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
