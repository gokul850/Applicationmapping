{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adm/harness/contracts/source-record.schema.json",
  "title": "Normalized Source Record",
  "description": "Source data preserved for analysis; adapters must minimize/redact fields before model use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_record_id", "record_type", "fields", "extraction_time"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["application", "technical_resource", "deployment", "relationship", "service", "unknown"]},
    "fields": {"type": "object", "description": "Only approved, minimized non-secret fields; preserve original names and values."},
    "extraction_time": {"type": ["string", "null"], "format": "date-time"},
    "source_reference": {"type": ["string", "null"]}
  }
}
