{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adm/harness/contracts/workflow.schema.json",
  "title": "ADM Harness Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "status", "description", "policy_refs", "inputs", "steps", "outputs", "failure_policy"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "approved_for_read_only_pilot", "retired"]},
    "description": {"type": "string", "minLength": 1},
    "policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "schema_ref", "required"], "properties": {"name": {"type": "string"}, "schema_ref": {"type": "string"}, "required": {"type": "boolean"}}}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "allowed_tools", "outputs", "on_failure"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
      "kind": {"enum": ["deterministic", "model", "human_gate", "stop"]},
      "description": {"type": "string"},
      "prompt_ref": {"type": ["string", "null"]},
      "allowed_tools": {"type": "array", "items": {"enum": ["file.read_scoped", "csv.profile", "schema.validate", "model.structured_output", "artifact.write_draft", "none"]}},
      "inputs": {"type": "array", "items": {"type": "string"}},
      "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "human_gate": {"type": ["object", "null"], "additionalProperties": false, "required": ["required", "reviewer_role", "criteria"], "properties": {"required": {"const": true}, "reviewer_role": {"type": "string"}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
      "on_failure": {"enum": ["stop_run", "queue_exception", "retry_once_then_stop"]}
    }}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "schema_ref", "draft_only"], "properties": {"name": {"type": "string"}, "schema_ref": {"type": "string"}, "draft_only": {"type": "boolean"}}}},
    "failure_policy": {"enum": ["fail_closed", "stop_on_policy_violation"]}
  }
}
